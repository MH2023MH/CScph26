<Project Sdk="Microsoft.NET.Sdk.Worker">

  <PropertyGroup>
    <TargetFramework>net8.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>dotnet-SecurityAgent.Worker-39b62d0b-0826-4ecb-bfbe-cd865a0a0825</UserSecretsId>
  </PropertyGroup>

  <ItemGroup>
    <PackageReference Include="Microsoft.Extensions.Hosting" Version="8.0.1" />
    <PackageReference Include="Microsoft.Extensions.Hosting.WindowsServices" Version="8.*" />
  </ItemGroup>

  <ItemGroup>
    <ProjectReference Include="..\SecurityAgent.Core\SecurityAgent.Core.csproj" />
    <ProjectReference Include="..\SecurityAgent.Collectors\SecurityAgent.Collectors.csproj" />
    <ProjectReference Include="..\SecurityAgent.Responders\SecurityAgent.Responders.csproj" />
    <ProjectReference Include="..\SecurityAgent.StatusApi\SecurityAgent.StatusApi.csproj" />
  </ItemGroup>
  <ItemGroup>
    <!-- Las reglas viajan junto al binario (rules\*.yaml) -->
    <Content Include="..\..\rules\*.yaml" Link="rules\%(Filename)%(Extension)" CopyToOutputDirectory="PreserveNewest" />
  </ItemGroup>

</Project>
